<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Mibo.Raylib 4.x requires FSharp.Core >= 10.1.302; align the SDK's implicit reference. -->
    <FSharpCoreImplicitPackageVersion>10.1.302</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Extensions.fs" />
    <Compile Include="World/Domain.fs" />
    <Compile Include="World/Tiles.fs" />
    <Compile Include="Diagnostics.fs" />
    <Compile Include="World/Systems/Map.fs" />
    <Compile Include="World/Systems/Enemies.fs" />
    <Compile Include="World/Systems/Spawning.fs" />
    <Compile Include="World/Systems/Waves.fs" />
    <Compile Include="World/Systems/Economy.fs" />
    <Compile Include="World/Systems/Towers.fs" />
    <Compile Include="World/Systems/Projectiles.fs" />
    <Compile Include="World/Systems/Vfx.fs" />
    <Compile Include="World/Systems/Camera.fs" />
    <Compile Include="World/Projections.fs" />
    <Compile Include="World/World.fs" />
    <Compile Include="Application.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mibo.Raylib" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AdaptiveSlop\src\AdaptiveSlop.Core\AdaptiveSlop.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
